#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

# --- stack (setup-proyecto) ---
install_stack() {
  npm ci
  npx playwright install --with-deps chromium
  if ! command -v ffmpeg >/dev/null 2>&1; then
    sudo apt-get update
    sudo apt-get install -y ffmpeg
  fi
}
# --- fin stack ---

install_stack
